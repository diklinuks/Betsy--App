# Copy to .env and fill in.

# --- Gemini (Google AI Studio, free tier) ---
# Get a key: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your-key-here

# Models (override to swap to Ollama later; see app/agent/model.py)
BETSY_CHAT_MODEL=gemini-2.5-flash
BETSY_REFLECTION_MODEL=gemini-2.5-flash
BETSY_EMBEDDING_MODEL=models/text-embedding-004

# --- Database (matches docker-compose.yml) ---
DATABASE_URL=postgresql+psycopg://betsy:betsy@localhost:5433/betsy

# --- Optional: LangSmith tracing (free tier) ---
# LANGCHAIN_TRACING_V2=true
# LANGCHAIN_API_KEY=your-langsmith-key
# LANGCHAIN_PROJECT=betsy
